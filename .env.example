# Blank means unset. Load with direnv, `uv run --env-file`, systemd or your shell.

# Root for <account>/filters/*.yaml, order.yaml, account.id.
# Default: $XDG_CONFIG_HOME/sieve-as-code, else ~/.config/sieve-as-code
SIEVE_AS_CODE_FILTERS_DIR=

# Root for <account>/backups/, retroactive/, audit.log.
# Default: $XDG_STATE_HOME/sieve-as-code, else ~/.local/state/sieve-as-code
SIEVE_AS_CODE_STATE_DIR=

# proton-cli profile used when --account is not given. Default: default
SIEVE_AS_CODE_ACCOUNT=

# proton-cli binary. Default: proton
SIEVE_AS_CODE_PROTON_CLI=
